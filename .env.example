# Cloudflare Workers AI carries Jev as the model `typesafe/jev`.
# This is the live route — no TypeSafe waitlist key required.
CF_ACCOUNT_ID=
CF_TOKEN=

# Optional: direct TypeSafe access instead (api.typesafe.ai), if you have a key.
TYPESAFE_API_KEY=

# "mock" | "jev" | "auto"
#   auto = Cloudflare, then TypeSafe, then the deterministic mock
#   jev  = demand a real backend; throw rather than score with heuristics
SCORER=auto
